{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "${configDir}/out-tsc",
        "rootDir": ".",
        "esModuleInterop": true,
        "exactOptionalPropertyTypes": true,
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true
    },
    "include": ["${configDir}/src", "${configDir}/*.ts"],
    "exclude": [
        "${configDir}/dist",
        "${configDir}/build",
        "${configDir}/out-tsc"
    ]
}
