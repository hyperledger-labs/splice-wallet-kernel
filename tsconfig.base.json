{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "composite": false,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "exactOptionalPropertyTypes": true,
        "strict": true,
        "skipLibCheck": true,
        "rootDir": "${configDir}/src",
        "outDir": "${configDir}/dist",
        "verbatimModuleSyntax": true,
        "isolatedModules": true
    },
    "include": ["${configDir}/src"],
    "exclude": [
        "${configDir}/dist",
        "${configDir}/build",
        "${configDir}/**/*.spec.ts",
        "${configDir}/**/*.test.ts",
        "${configDir}/**/__tests__/**"
    ]
}
