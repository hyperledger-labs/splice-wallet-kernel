{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noUncheckedIndexedAccess": true,
        "allowImportingTsExtensions": true,
        "noImplicitAny": true
    },
    "include": [
        "src",
        "../test-token-v1-registry/src/api/getTokenRulesFactory.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/__test__/**"
    ]
}
