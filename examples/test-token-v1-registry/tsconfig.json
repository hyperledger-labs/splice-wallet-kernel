{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noUncheckedIndexedAccess": true,
        "allowImportingTsExtensions": true,
        "noImplicitAny": true,
        "types": ["cors", "express", "lodash", "node"]
    },
    "include": ["src"],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/__test__/**"
    ]
}
