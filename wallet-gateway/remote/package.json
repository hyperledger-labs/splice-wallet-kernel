{
    "name": "@canton-network/wallet-gateway-remote",
    "version": "1.13.0",
    "type": "module",
    "description": "A server-side Wallet Gateway implementation over HTTP",
    "license": "Apache-2.0",
    "author": "Alex Matson <alex.matson@digitalasset.com>",
    "main": "dist/index.js",
    "bin": {
        "wallet-gateway": "dist/index.js",
        "wallet-gateway-remote": "dist/index.js"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.lib.json",
        "clean": "rm -rf ./dist && rm -f ./*.sqlite",
        "dev": "NODE_ENV=development tsx watch --exclude 'vite.config.ts.timestamp-*.mjs' src/index.ts -c ../test/config.json",
        "start": "pnpm node dist/index.js -c ../test/config.json",
        "debug": "pnpm node --inspect-brk dist/index.js -c ../test/config.json",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "db:bootstrap": "tsx ./src/index -c ../test/config.json db bootstrap",
        "db:migrate:up": "tsx ./src/index -c ../test/config.json db up",
        "db:migrate:down": "tsx ./src/index -c ../test/config.json db down",
        "db:migrate:status": "tsx ./src/index -c ../test/config.json db status",
        "db:migrate:reset": "tsx ./src/index -c ../test/config.json db reset",
        "signing-db:bootstrap": "tsx ./src/index -c ../test/config.json signing-db bootstrap",
        "signing-db:migrate:up": "tsx ./src/index -c ../test/config.json signing-db up",
        "signing-db:migrate:down": "tsx ./src/index -c ../test/config.json signing-db down",
        "signing-db:migrate:status": "tsx ./src/index -c ../test/config.json signing-db status",
        "signing-db:migrate:reset": "tsx ./src/index -c ../test/config.json signing-db reset"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@canton-network/core-ledger-client": "workspace:",
        "@canton-network/core-rpc-errors": "workspace:",
        "@canton-network/core-rpc-transport": "workspace:",
        "@canton-network/core-signing-bitgo": "workspace:",
        "@canton-network/core-signing-blockdaemon": "workspace:",
        "@canton-network/core-signing-dfns": "workspace:",
        "@canton-network/core-signing-fireblocks": "workspace:",
        "@canton-network/core-signing-internal": "workspace:",
        "@canton-network/core-signing-lib": "workspace:",
        "@canton-network/core-signing-participant": "workspace:",
        "@canton-network/core-signing-securosys": "workspace:",
        "@canton-network/core-signing-store-sql": "workspace:",
        "@canton-network/core-tx-visualizer": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@canton-network/core-wallet-dapp-rpc-client": "workspace:",
        "@canton-network/core-wallet-services": "workspace:",
        "@canton-network/core-wallet-store": "workspace:",
        "@canton-network/core-wallet-store-sql": "workspace:",
        "@canton-network/core-wallet-ui-components": "workspace:",
        "@canton-network/core-wallet-user-rpc-client": "workspace:",
        "@commander-js/extra-typings": "catalog:",
        "@logtape/adaptor-pino": "catalog:",
        "@logtape/logtape": "catalog:",
        "commander": "catalog:",
        "cors": "catalog:",
        "dotenv": "catalog:",
        "express": "catalog:",
        "express-rate-limit": "catalog:",
        "jose": "catalog:",
        "kysely": "catalog:",
        "lit": "catalog:",
        "pino": "catalog:",
        "pino-pretty": "catalog:",
        "vite": "catalog:",
        "vite-express": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@canton-network/core-wallet-store-inmemory": "workspace:",
        "@open-wc/testing-helpers": "catalog:",
        "@types/cors": "catalog:",
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "@types/supertest": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "pino-test": "catalog:",
        "playwright": "catalog:",
        "supertest": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "build": {
                "outputs": [
                    "{projectRoot}/dist"
                ]
            },
            "start": {
                "dependsOn": [
                    "^build",
                    "build"
                ]
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "wallet-gateway/remote"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/wallet-gateway/remote#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
