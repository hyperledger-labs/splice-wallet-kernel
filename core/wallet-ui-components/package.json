{
    "name": "@canton-network/core-wallet-ui-components",
    "version": "1.16.0",
    "type": "module",
    "description": "Reusable UI components for the Splice wallet",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css",
        "./themes": "./themes"
    },
    "scripts": {
        "build": "vite build",
        "build:watch": "vite build --watch & tsc --emitDeclarationOnly --watch",
        "typecheck": "tsc --noEmit",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist",
        "dev": "storybook dev -p 6006"
    },
    "devDependencies": {
        "@open-wc/testing-helpers": "catalog:",
        "@storybook/web-components-vite": "^10.4.6",
        "@types/bootstrap": "catalog:",
        "@types/fs-extra": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "fs-extra": "catalog:",
        "playwright": "catalog:",
        "storybook": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@canton-network/core-rpc-errors": "catalog:",
        "@canton-network/core-tx-visualizer": "catalog:",
        "@canton-network/core-types": "catalog:",
        "@canton-network/core-wallet-auth": "catalog:",
        "@canton-network/core-wallet-store": "catalog:",
        "@canton-network/core-wallet-user-rpc-client": "catalog:",
        "@popperjs/core": "catalog:",
        "bootstrap": "catalog:",
        "lit": "catalog:"
    },
    "files": [
        "dist/**",
        "themes/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/wallet-ui-components"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/wallet-ui-components#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
