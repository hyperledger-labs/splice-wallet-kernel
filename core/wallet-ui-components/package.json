{
    "name": "@canton-network/core-wallet-ui-components",
    "version": "1.17.0",
    "type": "module",
    "description": "Reusable UI components for the Splice wallet",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css",
        "./themes": "./themes",
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js",
            "require": "./dist/react/index.cjs",
            "default": "./dist/react/index.js"
        }
    },
    "scripts": {
        "build": "vite build",
        "build:watch": "vite build --watch & tsc -p tsconfig.lib.json --watch",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist",
        "dev": "storybook dev -p 6006 --no-open",
        "dev:lit": "storybook dev -p 6007 -c .storybook-lit --no-open"
    },
    "devDependencies": {
        "@mui/icons-material": "catalog:",
        "@mui/material": "catalog:",
        "@open-wc/testing-helpers": "catalog:",
        "@storybook/addon-a11y": "catalog:",
        "@storybook/addon-vitest": "catalog:",
        "@storybook/react-vite": "catalog:",
        "@storybook/web-components-vite": "catalog:",
        "@types/bootstrap": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "playwright": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "storybook": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@canton-network/core-rpc-errors": "workspace:",
        "@canton-network/core-tx-visualizer": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@canton-network/core-wallet-store": "workspace:",
        "@canton-network/core-wallet-user-rpc-client": "workspace:",
        "@logtape/logtape": "catalog:",
        "@popperjs/core": "catalog:",
        "bootstrap": "catalog:",
        "lit": "catalog:"
    },
    "peerDependencies": {
        "@mui/icons-material": "catalog:",
        "@mui/material": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "peerDependenciesMeta": {
        "@mui/icons-material": {
            "optional": true
        },
        "@mui/material": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "files": [
        "dist/**",
        "themes/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/wallet-ui-components"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/wallet-ui-components#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
