{
    "name": "@canton-network/core-splice-codegen",
    "version": "1.5.0",
    "type": "module",
    "description": "daml codegen js for default packages",
    "author": "Mateusz Piątkowski <mateusz.piatkowski@digitalasset.com>",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "pnpm --workspace-root generate:codegen && tsdown",
        "dev": "tsdown --watch",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@canton-network/core-ledger-client-types": "workspace:",
        "@canton-network/core-token-standard": "workspace:",
        "@canton-network/core-token-standard-v2": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@canton-network/wallet-sdk": "workspace:^",
        "@daml/types": "catalog:",
        "@mojotech/json-type-validation": "catalog:",
        "lodash": "catalog:",
        "openapi-fetch": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "playwright": "catalog:",
        "rolldown": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/splice-codegen"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/splice-codegen#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
