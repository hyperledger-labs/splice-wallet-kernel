{
    "name": "@canton-network/core-wallet-dapp-rpc-client",
    "version": "1.15.0",
    "type": "module",
    "description": "TypeScript client generated by OpenRPC",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json && pnpm run docs\"",
        "docs": "typedoc --tsconfig tsconfig.docs.json",
        "dev": "tsdown --watch --onSuccess \"tsc -p tsconfig.lib.json && pnpm run docs\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@canton-network/core-rpc-transport": "workspace:",
        "@canton-network/core-types": "workspace:"
    },
    "devDependencies": {
        "oxfmt": "catalog:",
        "tsdown": "catalog:",
        "typedoc": "catalog:",
        "typescript": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/wallet-dapp-rpc-client"
    },
    "homepage": "https://github.com/canton-network/wallet",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    },
    "nx": {
        "targets": {
            "build": {
                "outputs": [
                    "{projectRoot}/dist",
                    "{projectRoot}/docs"
                ]
            }
        }
    }
}
