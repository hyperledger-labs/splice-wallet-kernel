{
    "name": "@canton-network/core-token-standard-service",
    "version": "1.14.0",
    "type": "module",
    "description": "Provides a service layer that wraps the token-standard-client and contains higher level functions for interacting with token standard contracts on Canton.",
    "license": "Apache-2.0",
    "author": "Phillip Olesen <phillip.olesen@digitalasset.com>",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc\"",
        "dev": "tsdown --watch --onSuccess \"tsc\"",
        "clean": "tsc -b --clean; rm -rf dist",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\""
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "openapi-typescript": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@canton-network/core-acs-reader": "catalog:",
        "@canton-network/core-ledger-client-types": "catalog:",
        "@canton-network/core-provider-ledger": "catalog:",
        "@canton-network/core-splice-client": "catalog:",
        "@canton-network/core-token-standard": "catalog:",
        "@canton-network/core-token-standard-v2": "catalog:",
        "@canton-network/core-tx-parser": "catalog:",
        "@canton-network/core-types": "catalog:",
        "@canton-network/core-wallet-auth": "catalog:",
        "dayjs": "catalog:",
        "decimal.js": "catalog:",
        "openapi-fetch": "catalog:",
        "pino": "catalog:",
        "typescript-lru-cache": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/token-standard-service"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/token-standard-service#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
