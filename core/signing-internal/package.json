{
    "name": "@canton-network/core-signing-internal",
    "version": "2.1.0",
    "type": "module",
    "description": "Wallet Gateway driver for offline Ed25519 keypairs",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json\"",
        "dev": "tsdown --watch --onSuccess \"tsc -p tsconfig.lib.json\"",
        "clean": "rm -rf dist",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\""
    },
    "dependencies": {
        "@canton-network/core-signing-lib": "workspace:",
        "@canton-network/core-signing-store-sql": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@logtape/logtape": "catalog:",
        "lodash": "catalog:"
    },
    "devDependencies": {
        "@types/lodash": "catalog:",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "tsdown": "catalog:",
        "tweetnacl": "catalog:",
        "tweetnacl-util": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/signing-internal"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/signing-internal#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
