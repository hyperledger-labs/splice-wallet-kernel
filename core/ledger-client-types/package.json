{
    "name": "@canton-network/core-ledger-client-types",
    "version": "1.14.0",
    "type": "module",
    "description": "Contains TypeScript types for the Canton Network ledger client, generated by the OpenAPI spec, and utility functions",
    "license": "Apache-2.0",
    "author": "Phillip Olesen <phillip.olesen@digitalasset.com>",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc\"",
        "dev": "tsdown --watch --onSuccess \"tsc\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "openapi-typescript": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@canton-network/core-types": "workspace:",
        "dayjs": "catalog:",
        "openapi-fetch": "catalog:",
        "pino": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/ledger-client-types"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/ledger-client-types#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
