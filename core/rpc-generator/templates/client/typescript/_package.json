{
    "name": "core-rpc-generator-templates-client-typescript",
    "version": "0.0.0",
    "type": "module",
    "description": "TypeScript client generated by OpenRPC",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc --emitDeclarationOnly --declarationMap && pnpm run docs\"",
        "docs": "typedoc --tsconfig tsconfig.docs.json",
        "dev": "tsdown --watch --onSuccess \"tsc --emitDeclarationOnly --declarationMap && pnpm run docs\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist"
    },
    "files": ["dist/**"],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@canton-network/core-rpc-transport": "catalog:",
        "@canton-network/core-types": "catalog:"
    },
    "devDependencies": {
        "@canton-network/core-eslint-config": "catalog:",
        "eslint": "catalog:",
        "prettier": "catalog:",
        "tsdown": "catalog:",
        "typedoc": "catalog:",
        "typescript": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git"
    },
    "homepage": "https://github.com/canton-network/wallet",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    },
    "nx": {
        "targets": {
            "build": {
                "outputs": ["{projectRoot}/dist", "{projectRoot}/docs"]
            }
        }
    }
}
