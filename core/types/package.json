{
    "name": "@canton-network/core-types",
    "version": "2.0.0",
    "type": "module",
    "description": "Types and transport-agnostic parsers for data sent across Wallet components.",
    "license": "Apache-2.0",
    "author": "Alex Matson <alex.matson@digitalasset.com>",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc\"",
        "dev": "tsdown --watch --onSuccess \"tsc\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist"
    },
    "dependencies": {
        "@daml/types": "catalog:",
        "uuid": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/types"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/types#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
