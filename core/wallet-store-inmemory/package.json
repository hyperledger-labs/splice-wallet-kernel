{
    "name": "@canton-network/core-wallet-store-inmemory",
    "version": "1.17.0",
    "type": "module",
    "description": "In-memory implementation of the Store API",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json\"",
        "dev": "tsdown --watch --onSuccess \"tsc -p tsconfig.lib.json\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@canton-network/core-rpc-errors": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@canton-network/core-wallet-store": "workspace:",
        "@logtape/logtape": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/wallet-store-inmemory"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/wallet-store-inmemory#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
