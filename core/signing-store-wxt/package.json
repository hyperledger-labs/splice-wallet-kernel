{
    "name": "@canton-network/core-signing-store-wxt",
    "version": "1.4.0",
    "type": "module",
    "description": "WXT implementation of the Store API",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist"
    },
    "dependencies": {
        "@canton-network/core-ledger-client": "catalog:",
        "@canton-network/core-rpc-errors": "catalog:",
        "@canton-network/core-signing-lib": "catalog:",
        "@canton-network/core-wallet-auth": "catalog:",
        "@wxt-dev/storage": "catalog:",
        "wxt": "catalog:"
    },
    "devDependencies": {
        "@swc/core": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "tsdown": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/signing-store-sql"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/signing-store-sql#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
