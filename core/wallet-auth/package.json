{
    "name": "@canton-network/core-wallet-auth",
    "version": "2.1.0",
    "type": "module",
    "description": "Provides authentication middleware and user management for the Wallet Gateway",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json\"",
        "dev": "tsdown --watch --onSuccess \"tsc -p tsconfig.lib.json\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist"
    },
    "devDependencies": {
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@logtape/testing": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@canton-network/core-rpc-errors": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@logtape/logtape": "catalog:",
        "jose": "catalog:",
        "typescript-lru-cache": "catalog:",
        "zod": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/wallet-auth"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/wallet-auth#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
