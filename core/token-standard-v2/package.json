{
    "author": "Rukmini Basu <rukmini.base@digitalasset.com>",
    "name": "@canton-network/core-token-standard-v2",
    "version": "1.2.0",
    "type": "module",
    "description": "daml codegen js for core token standard v2",
    "license": "Apache-2.0",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/index.browser.js",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "pnpm clean && rollup -c && pnpm clean:types-tmp",
        "dev": "rollup -c -w",
        "clean:types-tmp": "rm -rf dist/types",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@daml/types": "catalog:",
        "@mojotech/json-type-validation": "catalog:",
        "lodash": "catalog:",
        "openapi-fetch": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@rollup/plugin-alias": "catalog:",
        "@rollup/plugin-commonjs": "catalog:",
        "@rollup/plugin-json": "catalog:",
        "@rollup/plugin-node-resolve": "catalog:",
        "@rollup/plugin-typescript": "catalog:",
        "playwright": "catalog:",
        "rollup": "catalog:",
        "rollup-plugin-dts": "catalog:",
        "tslib": "catalog:",
        "typescript": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/token-standard-v2"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/token-standard-v2#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
