{
    "name": "@canton-network/core-daml-codegen-helpers",
    "version": "1.14.0",
    "type": "module",
    "description": "Helpers for combining Daml codegen TypeScript output with the Splice Wallet SDK.",
    "license": "Apache-2.0",
    "author": "Phillip Olesen <phillip.olesen@digitalasset.com>",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json\"",
        "dev": "tsdown --watch --onSuccess \"tsc -p tsconfig.lib.json\"",
        "clean": "rm -rf dist",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\""
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/daml-codegen-helpers"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/daml-codegen-helpers#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
