{
    "name": "@canton-network/core-wallet-discovery",
    "version": "1.15.0",
    "type": "module",
    "description": "Wallet discovery, adapter pattern, and session management for the Canton Network.",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json\"",
        "dev": "tsdown --watch --onSuccess \"tsc -p tsconfig.lib.json\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@canton-network/core-splice-provider": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-dapp-rpc-client": "workspace:"
    },
    "devDependencies": {
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/wallet-discovery"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/wallet-discovery#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
