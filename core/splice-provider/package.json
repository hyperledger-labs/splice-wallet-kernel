{
    "name": "@canton-network/core-splice-provider",
    "version": "1.14.0",
    "type": "module",
    "description": "A JavaScript Splice Provider API (EIP-1193 compliant).",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc\"",
        "dev": "tsdown --watch --onSuccess \"tsc\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist"
    },
    "devDependencies": {
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@canton-network/core-rpc-transport": "catalog:",
        "@canton-network/core-types": "catalog:",
        "@canton-network/core-wallet-dapp-remote-rpc-client": "catalog:",
        "@canton-network/core-wallet-dapp-rpc-client": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/splice-provider"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/splice-provider#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
