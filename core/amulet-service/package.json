{
    "name": "@canton-network/core-amulet-service",
    "version": "2.1.0",
    "type": "module",
    "description": "A service layer for interacting with non-token-standard Amulet operations on Canton.",
    "license": "Apache-2.0",
    "author": "Phillip Olesen <phillip.olesen@digitalasset.com>",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json\"",
        "dev": "tsdown --watch --onSuccess \"tsc -p tsconfig.lib.json\"",
        "clean": "rm -rf dist",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\""
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "openapi-typescript": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@canton-network/core-ledger-client": "workspace:",
        "@canton-network/core-ledger-client-types": "workspace:",
        "@canton-network/core-splice-client": "workspace:",
        "@canton-network/core-token-standard-service": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@logtape/logtape": "catalog:",
        "decimal.js": "catalog:",
        "openapi-fetch": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/amulet-service"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/amulet-service#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
