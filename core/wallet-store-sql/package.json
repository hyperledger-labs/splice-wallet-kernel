{
    "name": "@canton-network/core-wallet-store-sql",
    "version": "1.14.0",
    "type": "module",
    "description": "SQL implementation of the Store API",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc\" && tsc -b tsconfig.migrations.json",
        "dev": "tsdown --watch --onSuccess \"tsc && tsc -b tsconfig.migrations.json\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist",
        "test:migrations": "vitest run --project migrations",
        "migrations:check-lock": "tsx ../../scripts/src/check-migration-lock.ts",
        "migrations:update-lock": "tsx ../../scripts/src/check-migration-lock.ts --update"
    },
    "dependencies": {
        "@canton-network/core-ledger-client": "catalog:",
        "@canton-network/core-rpc-errors": "catalog:",
        "@canton-network/core-types": "catalog:",
        "@canton-network/core-wallet-auth": "catalog:",
        "@canton-network/core-wallet-store": "catalog:",
        "better-sqlite3": "catalog:",
        "commander": "catalog:",
        "kysely": "catalog:",
        "pg": "catalog:",
        "pino": "catalog:",
        "umzug": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "catalog:",
        "@types/better-sqlite3": "catalog:",
        "@types/pg": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "pino-test": "catalog:",
        "tsdown": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/wallet-store-sql"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/wallet-store-sql#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    },
    "nx": {
        "targets": {
            "test": {
                "options": {
                    "args": "--project=node"
                }
            }
        }
    }
}
