{
    "name": "@canton-network/tool-conformance-cli",
    "version": "1.2.0",
    "type": "module",
    "description": "CLI and Playwright harness for the CIP-103 conformance dApp",
    "license": "Apache-2.0",
    "author": "Pascal Honegger <pascal.honegger@digitalasset.com>",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "conformance-cli": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.lib.json",
        "clean": "rm -rf dist",
        "run": "node src/cli.ts"
    },
    "dependencies": {
        "@canton-network/tool-conformance-dapp": "workspace:^",
        "commander": "catalog:",
        "ctrf": "catalog:",
        "express": "catalog:",
        "playwright": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@canton-network/core-wallet-dapp-rpc-client": "workspace:",
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "tools/conformance-cli"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/tools/conformance-cli#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
