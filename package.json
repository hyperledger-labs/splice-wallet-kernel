{
    "name": "wallet-kernel",
    "private": true,
    "type": "module",
    "scripts": {
        "start:all": "pnpm exec pm2 start ecosystem.config.js --env development",
        "start:canton": "tsx ./scripts/src/start-canton.ts",
        "start:canton:tls": "tsx ./scripts/src/start-canton.ts --network=mainnet --tls=true",
        "start:localnet": "tsx ./scripts/src/start-localnet.ts start",
        "start:canton:console": ".canton/bin/canton --config canton/canton.conf --bootstrap canton/bootstrap.canton",
        "stop:all": "pnpm exec pm2 stop all",
        "stop:localnet": "tsx ./scripts/src/start-localnet.ts stop",
        "pull:localnet": "tsx ./scripts/src/start-localnet.ts pull",
        "generate:dapp-remote": "pnpm --filter @canton-network/core-rpc-generator build && pnpm exec open-rpc-generator generate -c ./rpc-generator-config-dapp-remote.json",
        "generate:dapp": "pnpm --filter @canton-network/core-rpc-generator build && pnpm exec open-rpc-generator generate -c ./rpc-generator-config-dapp.json",
        "generate:user": "pnpm --filter @canton-network/core-rpc-generator build && pnpm exec open-rpc-generator generate -c ./rpc-generator-config-user.json",
        "generate:signing": "pnpm --filter @canton-network/core-rpc-generator build && pnpm exec open-rpc-generator generate -c ./rpc-generator-config-signing.json",
        "generate:grpc": "tsx ./scripts/src/generate-protobufs.ts",
        "generate:tokenstandard": "tsx ./scripts/src/generate-token-standard.ts",
        "generate:codegen": "tsx ./scripts/src/generate-daml-codegen.ts",
        "generate:all": "pnpm run generate:dapp && pnpm run generate:dapp-remote && pnpm run generate:user && pnpm run generate:signing && pnpm run generate:tokenstandard && pnpm run generate:codegen && pnpm exec prettier . --write > /dev/null 2>&1",
        "lint": "nx run-many -t lint --parallel",
        "build:all": "nx run-many -t build --parallel",
        "build:all:serial": "nx run-many -t build --parallel=1",
        "clean:all": "nx run-many -t clean --parallel && pnpm nx reset",
        "test:all": "nx run-many -t test --parallel",
        "test-coverage:all": "nx run-many -t test --parallel -c coverage",
        "script:coverage:report": "tsx ./scripts/src/coverage-report.ts",
        "postinstall": "husky",
        "docs:update-wg-config": "tsx ./scripts/src/docs-update-wg-config.ts",
        "script:cleancoding": "tsx ./scripts/src/clean-coding.ts",
        "script:install:dpm": "tsx --eval \"import { installDPM } from './scripts/src/install-dpm.ts'; installDPM()\"",
        "script:generate:openapi": "tsx ./scripts/src/generate-openapi-clients.ts",
        "script:generate:asyncapi": "tsx ./scripts/src/generate-asyncapi-clients.ts",
        "script:generate:protobufs": "tsx ./scripts/src/generate-protobufs.ts",
        "script:fetch:canton": "tsx ./scripts/src/fetch-canton.ts",
        "script:fetch:splice": "tsx ./scripts/src/fetch-splice.ts",
        "script:fetch:localnet": "tsx ./scripts/src/fetch-localnet.ts",
        "script:validate:package": "tsx ./scripts/src/package-and-verify-wallet-sdk.ts",
        "script:test:examples": "pnpm exec node --trace-uncaught --enable-source-maps --import tsx ./scripts/src/test-example-scripts.ts",
        "script:test:examples-stress": "tsx ./scripts/src/test-examples-scripts-under-stress.ts",
        "script:test:stress-scripts": "tsx ./scripts/src/test-stress-scripts.ts",
        "script:conformance-cli": "pnpm --filter @canton-network/tool-conformance-cli run run",
        "script:release": "tsx ./scripts/src/release.ts",
        "script:retag": "tsx ./scripts/src/retag.ts",
        "script:flat-pack": "tsx ./scripts/src/flat-pack.ts",
        "script:upgrade:splice": "tsx ./scripts/src/upgrade-splice.ts",
        "script:clear-blockdaemon-policies": "tsx ./scripts/src/clear-blockdaemon-policies.ts",
        "full:rebuild": "NX_TUI=false && pnpm run clean:all && pnpm run generate:all && pnpm install && pnpm run build:all --skip-nx-cache && NX_TUI=true",
        "full:down": "pnpm run stop:localnet && pnpm exec pm2 kill && pnpm run full:rebuild",
        "full:up": "pnpm run start:localnet && pnpm run start:all",
        "fetch:all": "pnpm script:fetch:canton && pnpm script:fetch:splice && pnpm script:fetch:localnet"
    },
    "devDependencies": {
        "@canton-network/core-eslint-config": "catalog:",
        "@commitlint/config-conventional": "catalog:",
        "@daml/types": "catalog:",
        "@eslint/js": "catalog:",
        "@nx/eslint": "catalog:",
        "@nx/eslint-plugin": "catalog:",
        "@nx/playwright": "catalog:",
        "@nx/storybook": "catalog:",
        "@nx/vitest": "catalog:",
        "@nx/web": "catalog:",
        "@open-rpc/generator": "catalog:",
        "@playwright/test": "catalog:",
        "@protobuf-ts/plugin": "catalog:",
        "@storybook/web-components-vite": "catalog:",
        "@swc-node/register": "catalog:",
        "@swc/core": "catalog:",
        "@swc/helpers": "catalog:",
        "@types/node": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "commitlint": "catalog:",
        "eslint": "catalog:",
        "eslint-plugin-headers": "catalog:",
        "globals": "catalog:",
        "grpc-tools": "catalog:",
        "husky": "catalog:",
        "jsonc-eslint-parser": "catalog:",
        "lint-staged": "catalog:",
        "lit": "catalog:",
        "oauth2-mock-server": "catalog:",
        "pino-pretty": "catalog:",
        "playwright": "catalog:",
        "pm2": "catalog:",
        "prettier": "catalog:",
        "storybook": "catalog:",
        "ts-node": "catalog:",
        "ts-proto": "catalog:",
        "tsdown": "catalog:",
        "tslib": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "lint-staged": {
        "*": "pnpm prettier --config .prettierrc --write --ignore-unknown",
        "*.{ts,tsx,js,jsx,mjs,cjs}": "pnpm eslint --fix"
    },
    "packageManager": "pnpm@12.10.1",
    "dependencies": {
        "@nx/js": "catalog:",
        "nx": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git"
    }
}
