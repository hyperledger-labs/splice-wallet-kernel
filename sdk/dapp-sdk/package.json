{
    "name": "@canton-network/dapp-sdk",
    "type": "module",
    "version": "1.8.0",
    "description": "Browser SDK for dApp development on the Canton Network",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json\"",
        "dev": "tsdown --watch --onSuccess \"tsc -p tsconfig.lib.json\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist",
        "test:integration": "vitest run --project browser-integration"
    },
    "dependencies": {
        "@canton-network/core-provider-dapp": "workspace:",
        "@canton-network/core-rpc-errors": "workspace:",
        "@canton-network/core-rpc-transport": "workspace:",
        "@canton-network/core-splice-provider": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-dapp-remote-rpc-client": "workspace:",
        "@canton-network/core-wallet-dapp-rpc-client": "workspace:",
        "@canton-network/core-wallet-discovery": "workspace:",
        "@canton-network/core-wallet-ui-components": "workspace:",
        "qrcode": "catalog:"
    },
    "peerDependencies": {
        "@walletconnect/sign-client": "^2.23.8",
        "@walletconnect/types": "^2.23.8"
    },
    "peerDependenciesMeta": {
        "@walletconnect/sign-client": {
            "optional": true
        },
        "@walletconnect/types": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/qrcode": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@walletconnect/sign-client": "catalog:",
        "@walletconnect/types": "catalog:",
        "playwright": "catalog:",
        "qrcode": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**",
        "gateways.json"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "sdk/dapp-sdk"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/sdk/dapp-sdk#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    },
    "nx": {
        "targets": {
            "test": {
                "dependsOn": [
                    "^build",
                    "test:integration"
                ],
                "options": {
                    "args": "--project=browser"
                }
            }
        }
    }
}
