{
    "name": "@canton-network/wallet-sdk",
    "type": "module",
    "version": "1.6.0",
    "description": "Node/browser SDK for integrating with Canton Network",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc\"",
        "dev": "tsdown --watch --onSuccess \"tsc\"",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist"
    },
    "dependencies": {
        "@canton-network/core-acs-reader": "catalog:",
        "@canton-network/core-amulet-service": "catalog:",
        "@canton-network/core-asyncapi-client": "catalog:",
        "@canton-network/core-ledger-client-types": "catalog:",
        "@canton-network/core-ledger-proto": "catalog:",
        "@canton-network/core-provider-dapp": "catalog:",
        "@canton-network/core-provider-ledger": "catalog:",
        "@canton-network/core-signing-lib": "catalog:",
        "@canton-network/core-splice-client": "catalog:",
        "@canton-network/core-splice-provider": "catalog:",
        "@canton-network/core-token-standard": "catalog:",
        "@canton-network/core-token-standard-v2": "catalog:",
        "@canton-network/core-token-standard-service": "catalog:",
        "@canton-network/core-tx-parser": "catalog:",
        "@canton-network/core-tx-visualizer": "catalog:",
        "@canton-network/core-types": "catalog:",
        "@canton-network/core-wallet-auth": "catalog:",
        "decimal.js": "catalog:",
        "jose": "catalog:",
        "pino": "catalog:",
        "pino-pretty": "catalog:",
        "typescript-lru-cache": "catalog:",
        "uuid": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "sdk/wallet-sdk"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/sdk/wallet-sdk#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
