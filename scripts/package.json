{
    "name": "@canton-network/scripts",
    "private": true,
    "version": "0.0.0",
    "description": "Various scripts for the Wallet Gateway Project.",
    "author": "Phillip Olesen <phillip.olesen@digitalasset.com>",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "clean": "tsc -b --clean"
    },
    "devDependencies": {
        "@open-rpc/meta-schema": "catalog:",
        "@types/js-yaml": "catalog:",
        "@types/node": "catalog:",
        "@types/tar-fs": "catalog:",
        "js-yaml": "catalog:",
        "openapi-typescript": "catalog:",
        "tar-fs": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@commander-js/extra-typings": "catalog:",
        "@inquirer/prompts": "catalog:",
        "@scalar/json-magic": "catalog:",
        "@scalar/openapi-parser": "catalog:",
        "@scalar/openapi-types": "catalog:",
        "commander": "catalog:",
        "inquirer-select-pro": "catalog:",
        "jsonc-parser": "catalog:",
        "pm2": "catalog:",
        "yoctocolors": "catalog:"
    },
    "nx": {
        "targets": {
            "generate:dapp": {
                "command": "tsx ./scripts/src/generate-rpc.ts ./rpc-generator-config-dapp.json",
                "dependsOn": [
                    {
                        "projects": [
                            "@canton-network/core-rpc-generator"
                        ],
                        "target": "build"
                    }
                ]
            },
            "generate:dapp-remote": {
                "command": "tsx ./scripts/src/generate-rpc.ts ./rpc-generator-config-dapp-remote.json",
                "dependsOn": [
                    {
                        "projects": [
                            "@canton-network/core-rpc-generator"
                        ],
                        "target": "build"
                    }
                ]
            },
            "generate:user": {
                "command": "tsx ./scripts/src/generate-rpc.ts ./rpc-generator-config-user.json",
                "dependsOn": [
                    {
                        "projects": [
                            "@canton-network/core-rpc-generator"
                        ],
                        "target": "build"
                    }
                ]
            },
            "generate:signing": {
                "command": "tsx ./scripts/src/generate-rpc.ts ./rpc-generator-config-signing.json",
                "dependsOn": [
                    {
                        "projects": [
                            "@canton-network/core-rpc-generator"
                        ],
                        "target": "build"
                    }
                ]
            },
            "generate:daml-setup": {
                "command": "tsx ./scripts/src/setup-daml.ts"
            },
            "generate:tokenstandard": {
                "command": "tsx ./scripts/src/generate-token-standard.ts",
                "dependsOn": [
                    "generate:daml-setup"
                ]
            },
            "generate:codegen": {
                "command": "tsx ./scripts/src/generate-daml-codegen.ts",
                "dependsOn": [
                    "generate:daml-setup"
                ]
            },
            "generate:all": {
                "executor": "nx:noop",
                "dependsOn": [
                    "generate:dapp",
                    "generate:dapp-remote",
                    "generate:user",
                    "generate:signing",
                    "generate:openapi",
                    "generate:asyncapi",
                    "generate:tokenstandard",
                    "generate:codegen"
                ]
            }
        }
    }
}
